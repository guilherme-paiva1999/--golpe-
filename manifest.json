{
  "manifest_version": 3,
  "name": "É Golpe?",
  "version": "2.5.0",
  "description": "Avisa sobre sites suspeitos, golpes e conteúdo feito por IA, com explicações simples.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "É Golpe?", "default_popup": "popup.html" },
  "permissions": ["storage", "alarms", "webNavigation", "activeTab"],
  "host_permissions": [
    "https://rdap.org/*",
    "https://raw.githubusercontent.com/*",
    "https://urlhaus.abuse.ch/*",
    "https://sistemas.procon.sp.gov.br/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
