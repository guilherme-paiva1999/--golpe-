{
  "manifest_version": 3,
  "name": "Isso é golpe?",
  "version": "3.18.2",
  "description": "Avisa sobre sites suspeitos e golpes, com explicações simples, acessibilidade e uma pessoa de confiança para perguntar.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Isso é golpe?", "default_popup": "popup.html" },
  "options_page": "boas-vindas.html",
  "permissions": ["storage", "alarms", "webNavigation", "activeTab", "tts"],
  "host_permissions": [
    "https://rdap.org/*",
    "https://rdap.registro.br/*",
    "https://raw.githubusercontent.com/*",
    "https://urlhaus.abuse.ch/*",
    "https://sistemas.procon.sp.gov.br/*",
    "https://brasilapi.com.br/*",
    "https://www.reclameaqui.com.br/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["icons/reclameaqui.png"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["pessoa.js", "alfabetos.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
